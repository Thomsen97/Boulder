  "components": {
    "schemas": {
      "MeDto": {
        "required": [
          "onboardingComplete",
          "status",
          "id",
          "username",
          "displayName",
          "bio",
          "avatarUrl",
          "isPrivate",
          "shareAscents",
          "spoilerMode",
          "usernameChangedAt",
          "guidelinesVersion"
        ],
        "type": "object",
        "properties": {
          "onboardingComplete": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "id": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "username": {
            "type": [
              "null",
              "string"
            ]
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          },
          "bio": {
            "type": [
              "null",
              "string"
            ]
          },
          "avatarUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "isPrivate": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "shareAscents": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "spoilerMode": {
            "type": [
              "null",
              "string"
            ]
          },
          "usernameChangedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "guidelinesVersion": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "OnboardingRequest": {
        "required": [
          "username",
          "displayName",
          "ageConfirmed",
          "guidelinesVersion"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "ageConfirmed": {
            "type": "boolean"
          },
          "guidelinesVersion": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UpdateMeRequest": {
        "required": [
          "displayName",
          "bio",
          "username",
          "isPrivate",
          "shareAscents",
          "spoilerMode"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          },
          "bio": {
            "type": [
              "null",
              "string"
            ]
          },
          "username": {
            "type": [
              "null",
              "string"
            ]
          },
          "isPrivate": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "shareAscents": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "spoilerMode": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UsernameAvailabilityDto": {
        "required": [
          "available",
          "reason"
        ],
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UserProfileDto": {
        "required": [
          "id",
          "username",
          "displayName",
          "bio",
          "avatarUrl",
          "isPrivate",
          "isOwn",
          "followerCount",
          "followingCount",
          "followState",
          "canViewContent"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "avatarUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "isPrivate": {
            "type": "boolean"
          },
          "isOwn": {
            "type": "boolean"
          },
          "followerCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "followingCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "followState": {
            "type": "string"
          },
          "canViewContent": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Boulder.Api"
    },
    {
      "name": "Users"
    }
  ]
}
