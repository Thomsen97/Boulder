# Mobile app environment. Copy to apps/mobile/.env (git-ignored). Expo reads .env only from this folder.
# EXPO_PUBLIC_ values are bundled into the app, so never put secrets here.

# mock | live | comma list such as "live,groups:mock" (default: mock)
EXPO_PUBLIC_API_MODE=mock
# Base URL of the API, e.g. http://192.168.1.10:5000 for a phone on the same network
EXPO_PUBLIC_API_URL=http://localhost:5000
