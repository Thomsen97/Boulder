{
  "name": "boulder-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "~15.1.1",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.2",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.16",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.28.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~30.5.2",
    "jest-expo": "~57.0.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "react-test-renderer": "19.3.0",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "start": "expo start",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "format": "prettier --write .",
    "api:types": "openapi-typescript ../../api/openapi/v1.json -o src/lib/api/schema.d.ts"
  },
  "private": true,
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "engines": {
    "node": ">=22"
  }
