# Boulder API - environment variables
# Copy this file to .env and fill in the real values.
# .env is git-ignored and must never be committed.

# PostgreSQL connection string
ConnectionStrings__Default=Host=localhost;Port=5432;Database=boulder_dev;Username=boulder;Password=changeme

# Serilog minimum level (optional override)
# Serilog__MinimumLevel__Default=Information

# Supabase (required from phase 3: the API refuses to start without the first two outside Development,
# where appsettings.Development.json holds placeholders that accept no real token)
Supabase__JwksUrl=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
Supabase__Issuer=https://your-project-ref.supabase.co/auth/v1
# Supabase__ServiceRoleKey=

# Rate limit overrides (optional; defaults follow SPEC SEC-6)
# RateLimiting__UsernameAvailabilityPerMinute=30

# Cloudflare R2 (needed from phase 11)
# R2__AccountId=
# R2__AccessKeyId=
# R2__SecretAccessKey=
# R2__BucketName=
# R2__PublicEndpoint=

# Expo push (needed from phase 18)
# ExpoPush__AccessToken=

# App version gate (optional; leave empty to allow all versions)
# AppVersion__Minimum=
