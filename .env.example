# Boulder API - environment variables
# Copy this file to .env and fill in the real values.
# .env is git-ignored and must never be committed.

# PostgreSQL connection string
ConnectionStrings__Default=Host=localhost;Port=5432;Database=boulder_dev;Username=boulder;Password=changeme

# Serilog minimum level (optional override)
# Serilog__MinimumLevel__Default=Information

# Supabase (needed from phase 3)
# Supabase__JwksUrl=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# Supabase__Issuer=https://<project>.supabase.co/auth/v1
# Supabase__ServiceRoleKey=

# Cloudflare R2 (needed from phase 11)
# R2__AccountId=
# R2__AccessKeyId=
# R2__SecretAccessKey=
# R2__BucketName=
# R2__PublicEndpoint=

# Expo push (needed from phase 18)
# ExpoPush__AccessToken=

# App version gate (optional; leave empty to allow all versions)
# AppVersion__Minimum=

# Mobile app (apps/mobile, read by Expo at build time; EXPO_PUBLIC_ values are not secret)
# mock | live | comma list such as "live,groups:mock" (default: mock)
EXPO_PUBLIC_API_MODE=mock
# Base URL of the API, e.g. http://192.168.1.10:5000 for a phone on the same network
EXPO_PUBLIC_API_URL=http://localhost:5000
